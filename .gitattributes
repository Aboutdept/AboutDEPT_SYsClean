# Normalize line endings on checkout, store LF in the repo.
# Windows users get CRLF locally for .bat; everything else stays LF.
* text=auto eol=lf

# Windows scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary
*.ico binary
*.png binary
*.exe binary
*.dll binary

# Rule databases are text but large — keep them diffable
*.ini text
*.md  text
*.py  text
